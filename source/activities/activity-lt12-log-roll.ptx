<exercise>
    <introduction>
        <p>
            (Can you draw a line to the equations that are equivalent?) </p>
        <p> Use Desmos to evaluate each exponential and log equation to find the numerical value for x and place it on the iine  
    
        </p>
   
    <tabular top="minor" bottom="medium" left="major" right="major">
  <title>Systems Parmaeters</title>
  <col>width=50% halign="center"</col>
  <col>width=50%</col>
  <row header="yes" halign="center" >
    <cell><p><m>5^x=3</m>_______________________</p>
        <p>&#160;</p>______________</cell>
    <cell><p><m>log_x5=3</m>_______________________</p>
        <p>&#160;</p> </cell>
             </row>
  <row halign="center">
  <cell><p><m>3^x=5</m>_______________________</p>
        <p>&#160;</p>_____________</cell>
    <cell><p><m>\frac{log5}{log3}</m>_______________________</p>
        <p>&#160;</p>_____________</cell>
  </row>
  <row header="yes" halign="center" >
    <cell><p><m>3^5=x</m>_______________________</p>
          <p>&#160;</p>_____________</cell>
    <cell><p><m>log_5x=3</m>_______________________</p>
            <p>&#160;</p>_____________</cell>
             </row>
    <row header="yes" halign="center" >
    <cell><p><m>x^3=5</m>_______________________ </p>
          <p>&#160;</p>_____________</cell>
    <cell><p><m>log_35=x</m>_______________________</p>
    <p>&#160;</p>_____________</cell>
             </row>
    <row header="yes" halign="center" >
    <cell><p><m>5^3=x</m>_______________________</p>
          <p>&#160;</p>_____________</cell> 
    <cell><p><m>log_53=x</m>_______________________</p>
          <p>&#160;</p>_____________</cell>
             </row>
    <row header="yes" halign="center" >
    <cell><p><m>\sqrt[3]{x}=5</m>_______________________</p>
           <p>&#160;</p>_____________</cell> 
    <cell><p><m>xlog5=log3</m>_______________________</p>
    <p>&#160;</p>_______________________</cell> 
             </row>
             <row header="yes" halign="center" >
    <cell><p><m>x=5^{\frac{1}{3}}</m>_______________________</p>
           <p>&#160;</p>_____________</cell> 
    <cell><p><m>log_3(x)=5</m>_______________________</p>
    <p>&#160;</p>_______________________</cell> 
