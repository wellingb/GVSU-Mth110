<worksheet>
 <title>LT 4Linear Characteristics</title>

<exercise>
<statement>
  <p>
    For each representation below:
    <ul>
      <li>
        <p>
          Find or indicate the vertical intercept.
        </p>
      </li>
      <li>
        <p>Find or indicate the slope.
         
        </p>
      </li>
      <li>
        <p>
          Explain the behavior of the line and your reasoning for your answer.
        </p>
      </li>
      <li>
        <p>
          Find the equation of the line represented.
        </p>
      </li>
    </ul>
  </p>
  <tabular top="minor" bottom="medium" left="major" right="major">
    <col width="20%" halign="center" />
    <col width="20%" halign="center" />
    <col width="20%" halign="center" />
    <col width="20%" halign="center" />
    <col width="20%" halign="center" />


   <row header="yes" halign="center" >
    <cell>Representation</cell>
    <cell>Vertical Intercept</cell>
    <cell>Slope</cell>
    <cell>Behavior (Incr/Decr/Vertical/Horz)</cell>
    <cell>Equation</cell>
  </row>
  <row halign="center">
    <cell><m>f(x)=2*x-2</m></cell>
    <cell></cell>
    <cell></cell>
    <cell></cell>
    <cell></cell>
  </row>
  <row halign="center">
    <cell>(-3,6), (3, -12)</cell>
    <cell> </cell>
    <cell> </cell>
    <cell> </cell>
    <cell> </cell>
  </row>
  <row halign="center">
    <cell>(-5,-4), (2, 3)</cell>
    <cell> </cell>
    <cell> </cell>
    <cell> </cell>
    <cell> </cell>
  </row>
  <row halign="center">
    <cell>
      <p>
        A line contains the point (2,6) and is parallel to the line <m>y=4x+8</m>.
      </p>
    </cell>
    <cell></cell>
    <cell></cell>
    <cell></cell>
    <cell></cell>
  </row>
<row halign="center">
    <cell><image><prefigure xmlns="https://prefigure.org"
             label="prefigure-rectangle-b">
    <diagram dimensions="(300,300)" margins="5">
      <definition>f(x)=-0.75*x+1.5</definition>
      <coordinates bbox="(-4,-4,5,5)">
        <grid-axes xlabel="x" ylabel="y" hticks="(-4,1,5)" vticks="(-4,1,5)"/>
         <graph function="f"/>
      </coordinates>
    </diagram>
  </prefigure></image></cell>
    <cell></cell>
    <cell></cell>
    <cell></cell>
    <cell></cell>
  </row>
