    <exercise>
    <introduction>
        <p>
            We know that logs and exponential are inverses of each other.  Use this fact to solve the following equations.
        </p>
    </introduction>
    <task workspace="0.1in">
        <statement>
            <p>
                <m>log_2(x)=5</m>
            </p>
        </statement>
    </task>
    <task workspace="0.1in">
        <statement>
