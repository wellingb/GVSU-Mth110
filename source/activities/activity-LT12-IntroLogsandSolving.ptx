                <m>log_x(49)=2</m>
            </p>
        </statement>
    </task>
    <task workspace="0.1in">
        <statement>
            <p>
                <m>log_5(25)=x</m>
            </p>
        </statement>
    </task>
    <task workspace="0.1in">
