        <statement>
            <p>
                TASK 4: Complete the table using the equation <m>f(x)=152(0.85)^x</m>. Round to 3 decimal places.
            </p>
    <tabular top="minor" bottom="medium" left="major" right="major">
     <col>width=20% halign="center"</col>
